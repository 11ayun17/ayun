用for循环
public class Main {
    public static void main(String[] args) {
        for (int i = 1; i <=9 ; i++) {
            for (int j = 1; j <=9 ; j++) {
                if(i*j<10)
                    System.out.print(i+"*"+j+"="+i*j+"  ");
                else
                    System.out.print(i+"*"+j+"="+i*j+" ");
            }
            System.out.println();
        }

    }
}
用while循环
public class Main2 {
    public static void main(String[] args) {
        int i = 1;
        while (i <= 9) {
            int j = 1;
            while (j <= 9) {
                if(i*j < 10)
                    System.out.print(i+"*"+j+"="+i*j+"  ");
                else
                    System.out.print(i+"*"+j+"="+i*j+" ");
                j++;
            }
            System.out.println();
            i++;
        }
    }
}
